# Set these in the shell before launch. The application does not auto-load .env.
STUDIO_DATA=.studio-data
STUDIO_MAX_MB=200
STUDIO_MAX_PAGES=2000
STUDIO_MAX_PIXELS=24000000
STUDIO_MAX_HISTORY=40
STUDIO_TIMEOUT=180
STUDIO_RETENTION_HOURS=24

# Optional absolute paths for custom installations; otherwise auto-discovered.
# STUDIO_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# STUDIO_TESSDATA_DIR=C:\Users\YourName\AppData\Local\PDFStudioPro\tessdata
